---
import Base from '../layouts/Base.astro';
import CaseHero from '../components/CaseHero.astro';
import Module from '../components/Module.astro';
import DarkBand from '../components/DarkBand.astro';
import BookCarousel from '../components/BookCarousel.astro';
import Figure from '../components/Figure.astro';
import Decisions from '../components/Decisions.astro';
import MoreWork from '../components/MoreWork.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { getProject } from '../data/projects';
import hero from '../assets/glenmede/hero.png';
import d1 from '../assets/glenmede/doc-1-getting-started.png';
import d2 from '../assets/glenmede/doc-2-guidelines.png';
import d3 from '../assets/glenmede/doc-3-colors.png';
import d4 from '../assets/glenmede/doc-4-code.png';
import d5 from '../assets/glenmede/doc-5-typography.png';
import fContainers from '../assets/glenmede/feature-containers.png';
import fAlerts from '../assets/glenmede/feature-alerts.png';
import fCharts from '../assets/glenmede/feature-charts.png';
import fHeatmap from '../assets/glenmede/feature-heatmap.png';
import fBasics from '../assets/glenmede/feature-basics.png';

const p = getProject('project-8-glenmede-design-system');

const docPages = [
  [d1, 'Getting started', 'How the library connects to every app file, three ways to theme it for a client, and step by step setup.'],
  [d2, 'Guidelines & naming', 'How to change typography, colors, breakpoints, radius and dark mode, plus the naming rules that keep 250+ components searchable.'],
  [d3, 'Colors & effects', 'The full palette hierarchy, with a light and a dark value for every color variable.'],
  [d4, 'Variables in code', 'Every token exported in CSS format for light and dark mode, plus a dated update history for developers.'],
  [d5, 'Typography', 'Font, weight, size and line height variables, and the heading and body styles built from them.'],
] as const;

const steps = [
  ['Start from variables', 'Every color, font, weight, radius and breakpoint is a variable first. Components only reference variables, so one change flows through the whole system.'],
  ['Build components for every screen size', 'Each component ships with variants for its states and sizes, and app containers resize across four breakpoints from mobile to large desktop.'],
  ['Design light and dark together', 'All 158 color variables have a light value and a dark value, so every component switches modes without a second set of designs.'],
  ['Document as I go', 'Each page opens with a title block that explains what its components are for, and the Documentation page covers setup, theming, naming and code.'],
  ['Keep it current', 'I log variable updates with dates and keep the code export in step with the design file, so developers always know what changed and when.'],
];
const features = [
  ['Basic elements: the building blocks of every screen', 'Dropdowns, text fields, buttons and segmented controls come in every size and state: default, hover, focus, error and disabled. Labels, tooltips and help text are built in, so every form behaves the same way.', fBasics, 'Dropdowns, text fields, buttons and segmented controls from the library in every state'],
  ['App containers, responsive in light and dark', 'Common and story app containers set the frame for every module. Each one resizes across breakpoints and switches between light and dark mode from the same variables.', fContainers, 'Common and story app containers at five widths in light and dark mode'],
  ['36 card and list sets', 'Alert cards alone come in 38 variants for price moves, volume, ratings, splits, spin offs, earnings and dividends, each with its own mini chart.', fAlerts, 'A grid of alert card variants for price, volume, ratings, splits, dividends and earnings'],
  ['88 sets for data-dense screens', 'Line, bar, donut, treemap, event and yield curve charts share one set of chart colors, so data reads the same everywhere in the app.', fCharts, 'Growth of $10K line chart with highlighted periods and value labels'],
  ['Heatmaps: markets at a glance', 'Heatmap cells, labels and groups let teams build sector and correlation views that drill down from sectors into sub-industries.', fHeatmap, 'Sector heatmap with drill down into health care sub-industries'],
] as const;
---
<Base title={`${p.title} | Jeremy Hamann`} description={p.description}>
  <div class="case">
    <div class="top">
      <CaseHero project={p} image={hero} bg="var(--hero-glenmede)" title="Design System for Wealth Apps" artWidth={403} textWidth={361} gap={36} alt="The Glenmede Style Library cover with alert cards, buttons and a sector heatmap from the library" />

      <Module title="Goals" icon="target_check">
        <div class="prose">
          <p>Every designer today needs to know how to create, maintain and use a design system. It is what lets a team move fast without losing quality. The Glenmede Style Library is one of dozens of design systems I help create, maintain and use on a regular basis.</p>
          <p>It holds every component needed to design Glenmede’s wealth management apps on desktop and mobile, along with all of the typography and color variables for light and dark mode. Developers and product managers use it as a storehouse they can build from easily, with documentation on use cases and quick access to CSS and HTML.</p>
        </div>
      </Module>

      <Module title="Results" icon="sports_score">
        <div class="prose tight">
          <p>250+ component sets, with 2,200+ variants across 23 categories.</p>
          <p>189 design variables, including 158 colors with light and dark values.</p>
          <p>4 responsive breakpoints, from mobile up to large desktop.</p>
        </div>
      </Module>

      <Module title="About The Client" icon="apartment" id="about-client">
        <div class="prose tight">
          <p>$52.6B in assets under management, as of September 30, 2026.</p>
          <p>Founded in 1956 as The Glenmede Trust Company.</p>
          <p>Privately owned and independent, with nine offices.</p>
          <p>Source: <a href="https://www.glenmede.com/" target="_blank" rel="noopener">glenmede.com</a></p>
        </div>
      </Module>
    </div>

    <DarkBand label="The Documentation" icon="description" id="documentation">
      <p slot="intro">A design system is only as good as its documentation. The library’s Documentation page answers the questions designers, developers and product managers ask most, right inside the Figma file. It starts with Getting started: how the library connects to every app file, three ways to theme it for a client, and step by step setup.</p>
      <BookCarousel label="Documentation pages" bg="#cfdbe3" fit="contain" pages={docPages.map(([img, title], i) => ({ img, caption: `Page 0${i + 1} · ${title}`, alt: `Documentation, ${title}` }))} />
    </DarkBand>

    <Decisions items={[
      { title: 'Make variables the single source of truth', constraint: 'The same components have to serve Glenmede’s brand, light and dark mode and every screen size.', tradeoff: 'More setup up front, but a font or color change is made once and flows to every component and app file.' },
      { title: 'Keep documentation inside the library', constraint: 'Designers, developers and product managers all need answers without waiting on a designer.', tradeoff: 'Docs have to be updated alongside the components, but they are always one click away from the thing they describe.' },
      { title: 'Export variables in code format', constraint: 'Developers build in CSS, not Figma.', tradeoff: 'Another artifact to keep in sync, but handoff is a copy and paste, and a dated update log shows exactly what changed.' },
    ]} />

    <Module title="How I Maintain It" icon="build">
      <div class="prose">
        {steps.map(([t, d], i) => <p>{String(i + 1).padStart(2, '0')}&nbsp; {t}. {d}</p>)}
      </div>
    </Module>

    <Module title="What’s In The Library" icon="library_books">
      <p>23 categories of components cover everything a wealth management app needs, from buttons and inputs to tables, cards, charts and data visualization.</p>
    </Module>

    {features.map(([t, d, img, alt], i) => (
      <Module title={t} step={String(i + 1).padStart(2, '0')}>
        <p>{d}</p>
        <Figure src={img} alt={alt} sizes="(max-width: 1040px) 100vw, 952px" />
      </Module>
    ))}

    <DarkBand label="Outcomes" icon="sports_score" id="outcomes">
      <p slot="intro">The Glenmede Style Library gives everyone on the project one place to start. Designers build screens from tested components, developers copy tokens straight into code, and product managers can see what exists before they ask for something new. It is one of dozens of systems I work in every week, and it shows what I believe about design systems: the best ones are as easy to use as they are complete.</p>
    </DarkBand>

    <ContactCTA variant="dark" />

    <MoreWork slugs={['project-7-ai-design-documentation', 'project-3-mai-advisor-portal']} />
  </div>
</Base>
