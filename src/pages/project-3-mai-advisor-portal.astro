---
import Base from '../layouts/Base.astro';
import CaseHero from '../components/CaseHero.astro';
import Module from '../components/Module.astro';
import DarkBand from '../components/DarkBand.astro';
import Figure from '../components/Figure.astro';
import Decisions from '../components/Decisions.astro';
import MoreWork from '../components/MoreWork.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { getProject } from '../data/projects';
import hero from '../assets/mai/hero.png';
import grid from '../assets/mai/screens-grid.png';
import fDash from '../assets/mai/feature-dashboard.png';
import fHouseholds from '../assets/mai/feature-households.png';
import fMoneyMap from '../assets/mai/feature-money-map.png';
import fPfs from '../assets/mai/feature-pfs.png';
import fPortfolios from '../assets/mai/feature-portfolios.png';
import fMeetings from '../assets/mai/feature-meetings.png';
import fChat from '../assets/mai/feature-ai-chat.png';
import fDocs from '../assets/mai/feature-documents.png';

const p = getProject('project-3-mai-advisor-portal');
const prototypeUrl =
  'https://www.figma.com/proto/gLe52BuXyX4JKNM1jMPzFC/MAI?node-id=22-61534&p=f&viewport=-231%2C97%2C0.03&t=4XksfDY3GsXqLfVj-1&scaling=min-zoom&content-scaling=fixed&starting-point-node-id=22%3A61534&page-id=0%3A1';

const features = [
  ['An advisor’s whole book at a glance', 'Book totals, a ClientScore™ chart that plots every client by net worth and cash flow, households by priority, AI recommended actions, alerts, market movers and a daily AI podcast briefing.', fDash, 'Advisor home dashboard with book totals, ClientScore chart and households'],
  ['Every relationship in one place', 'Households group family members, trusts and foundations, with total AUM, a HouseholdScore™, accounts, transactions, holdings, recent documents and the full client team.', fHouseholds, 'Household profile with members, asset allocation, accounts and holdings'],
  ['Money Map: from uploaded documents to a balance sheet', 'Advisors upload statements and AI maps each value to the right asset, liability, income or expense, with a confidence score. The advisor approves, rejects or edits every pair before anything is saved.', fMoneyMap, 'Money Map document mapping review with confidence scores'],
  ['Net worth and cash flow, explained', 'A full personal financial statement for each client or household, with an AI-written client story, ClientScore™ and every category ready to expand, connect or update.', fPfs, 'Personal financial statement with ClientScore and AI client story'],
  ['Deep account detail on demand', 'Market value over time, allocation by asset class, sub-asset class and sector, plus performance, gains and losses, tax lots and transactions, with an AI portfolio story.', fPortfolios, 'Portfolio summary with market value chart and asset class allocation'],
  ['Prepare, record and recap meetings', 'A meeting space with an AI proposed agenda, client summary and pre-meeting email, live recording, then a transcript, outline, to-dos, follow-up email and meeting score.', fMeetings, 'Meeting space with an AI proposed agenda'],
  ['Ask anything about your book', 'An Intelligent Adviser Agent that answers in plain language, like a financial summary of a client with their key data, available from anywhere in the portal.', fChat, 'AI chat answering a request for a client financial summary'],
  ['Statements, research and education', 'A document vault for every client and account, plus MAI Insights articles, podcasts, markets research and education content that advisors can share with clients.', fDocs, 'Documents page with recent documents and a statements table'],
] as const;
---
<Base title={`${p.title} | Jeremy Hamann`} description={p.description}>
  <div class="case">
    <div class="top">
      <CaseHero project={p} image={hero} bg="var(--hero-mai)" title={'AI-Driven\nAdvisor Portal'} artWidth={447} textWidth={324} alt="MAI advisor portal screens: log in, household profile and the advisor dashboard" />

      <Module title="Goals" icon="target_check">
        <div class="prose">
          <p>MAI Capital Management is one of the largest wealth managers in the country, and they wanted a completely revamped digital experience for their advisors. I was the lead product designer from the very beginning. I supported our sales team with marketing and sales materials, created the first designs, and led design all the way through. It’s the most complex AI-driven wealth management suite Communify has designed to date, built on our wealth management product library, and one of the largest deals Communify has ever made.</p>
          <p>To win and keep that trust, the client had to feel the product long before it was built. So I made the prototype the centerpiece of the project.</p>
        </div>
      </Module>

      <Module title="Results" icon="sports_score">
        <div class="prose tight">
          <p>100+ screens in one prototype, from log in to household financial statements.</p>
          <p>2,300+ prototype interactions, including 180+ overlays and modals.</p>
          <p>One of the largest deals in Communify history, for an $80.4B wealth manager.</p>
        </div>
      </Module>

      <Module title="About The Client" icon="apartment" id="about-client">
        <div class="prose tight">
          <p>$80.4B in combined assets: $73.8B under management and $6.6B under advisement, as of June 30, 2026.</p>
          <p>Headquartered in Cleveland, Ohio, with 42+ offices across the United States.</p>
          <p>Majority-owned by funds managed by Carlyle, with employees holding a minority stake.</p>
          <p>Source: <a href="https://mai.capital/firm/" target="_blank" rel="noopener">mai.capital</a></p>
        </div>
      </Module>
    </div>

    <DarkBand label="The Prototype" icon="devices" id="prototype">
      <Fragment slot="intro">
        <p>I built this prototype as a living tool for our product managers, data experts and business development team. They used it again and again to walk MAI through the designs, so it had to work end to end without me in the room.</p>
        <p><a href={prototypeUrl} target="_blank" rel="noopener">Open the live prototype in Figma ↗</a></p>
      </Fragment>
      <div class="screens">
        <Figure src={grid} alt="Twelve screens from the MAI advisor portal prototype" sizes="(max-width: 1200px) 100vw, 1000px" />
      </div>
    </DarkBand>

    <Decisions title="The Big Decisions Along the Way" items={[
      { title: 'Build one connected prototype instead of separate demo flows', constraint: 'Product managers, data experts and business development all had to present the vision to MAI, often without a designer in the room.', tradeoff: 'A much bigger file to build and maintain, but every presenter tells the same story, from log in to insight.' },
      { title: 'Build on our wealth management product library', constraint: 'A completely revamped suite, on the timeline of one of Communify’s largest deals.', tradeoff: 'Less room for one-off visuals, but MAI’s brand sits on proven components, so what the client sees maps straight to what engineering builds.' },
      { title: 'Keep the prototype alive as the designs changed', constraint: 'The designs kept evolving as the client gave feedback throughout the deal.', tradeoff: 'Ongoing upkeep every time a screen changed, but the prototype was always the current source of truth for demos.' },
    ]} />

    <Module title="How I Built It" icon="construction">
      <div class="prose">
        <p>01&nbsp; Start at the front door. The prototype opens on MAI’s branded log in and multi-factor screens, then lands on the advisor’s home dashboard.</p>
        <p>02&nbsp; Map every journey. Home, Clients, Households, Meetings, Money Map, AI Chat, Documents, MAI Insights, Markets &amp; Research, Podcasts and Education all connect, so presenters can follow a client from the dashboard to their household, their statement and their next meeting.</p>
        <p>03&nbsp; Let components do the work. Tabs, toggles and expandable rows are interactive components with their own states, so a click changes the screen in place.</p>
        <p>04&nbsp; Layer in overlays. More than 180 overlays bring in modals, AI stories, ClientScore™ details and the document mapping review on top of the page.</p>
        <p>05&nbsp; Keep it presentation ready. One starting point and fixed content scaling mean anyone on the team can open the link and present. As the designs changed, I kept the prototype current.</p>
      </div>
    </Module>

    <Module title="Key Features" icon="apps" id="features">
      <p>The portal brings an advisor’s whole book together: dashboards, clients, households, accounts, meetings, documents and insights, with AI built into every part and proprietary tools like Money Map.</p>
    </Module>
    {features.map(([t, d, img, alt], i) => (
      <Module title={t} step={String(i + 1).padStart(2, '0')}>
        <p>{d}</p>
        <Figure src={img} alt={alt} />
      </Module>
    ))}

    <DarkBand label="Outcomes" icon="sports_score" id="outcomes">
      <p slot="intro">The prototype became the way the whole team talked about the product. Product managers, data experts and business development used it to present to MAI throughout the deal, and it helped land one of the largest deals in Communify’s history. Above all, it shows what I love about prototyping: when people can click through the real thing, the conversation moves from “what if” to “when.”</p>
    </DarkBand>

    <ContactCTA variant="dark" />

    <MoreWork slugs={['project-4-ai-notetaker', 'project-2-commsec']} />
  </div>
</Base>

<style>
  .screens { padding: 0 var(--band-pad) 64px; max-width: var(--band-max); margin-inline: auto; }
  .screens :global(img) { border-radius: 0; }
</style>
