---
// Home laid out like a video watch page: the intro video is the centerpiece,
// projects sit in the right-hand "up next" column, and skills read as the comments.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { projects, contact } from '../data/projects';
import { url } from '../lib/url';
import portrait from '../assets/home/portrait.png';
import imgMobile from '../assets/seven-post/feature-mobile.png';
import imgAi from '../assets/ai-notetaker/feature-transcription.png';
import imgData from '../assets/commsec/feature-currencies.png';
import imgSystem from '../assets/commsec/feature-sector.png';
import imgResearch from '../assets/schwab-reports/affinity-map.png';
import imgResponsive from '../assets/schwab-trading/desktop.png';

const skills = [
  { skill: '0→1 product design', body: 'Took a wealth client portal from zero digital footprint to launch in under 9 months. It now carries $10B in assets and $1.5M in ARR.', href: '/project-1-seven-post-client-portal', img: imgMobile, project: 'Seven Post client portal' },
  { skill: 'AI product design', body: 'Designed an AI note taker that records, transcribes and suggests action items, with advisors approving or dismissing every one.', href: '/project-4-ai-notetaker', img: imgAi, project: 'AI note taking' },
  { skill: 'Data-dense UI', body: 'Turned global markets data into a research experience 3M CommSec customers can read at a glance.', href: '/project-2-commsec', img: imgData, project: 'CommSec markets research' },
  { skill: 'Design systems', body: 'Built a new MUI-based system for Australia’s largest online broker, with modules that work on any platform or theme.', href: '/project-2-commsec', img: imgSystem, project: 'CommSec markets research' },
  { skill: 'Research & testing', body: 'Ran dozens of test rounds with Schwab clients and advisors, then used affinity mapping to turn findings into layout changes.', href: '/project-6-schwab-reports', img: imgResearch, project: 'Schwab managed account reports' },
  { skill: 'Responsive design', body: 'Wrote the responsive rules for 30+ data-heavy trading modules and took Schwab’s research section from beta to production.', href: '/project-5-schwab-trading', img: imgResponsive, project: 'Schwab trading platform' },
];

const telHref = contact.phone ? `tel:${contact.phone.replace(/[^+\d]/g, '')}` : '';
---
<Base title="Jeremy Hamann - Senior Product Designer" description="Senior Product Designer in fintech and AI. Watch the intro, browse case studies, and get in touch.">
  <div class="wrap watch">
    <div class="primary">
      <!-- Placeholder until the intro video is ready: swap this div for a <video> or embed. -->
      <div class="video" role="img" aria-label="Intro video coming soon">
        <span class="play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        </span>
        <span class="video-note">Intro video coming soon</span>
      </div>

      <h1 class="video-title">Jeremy Hamann - Senior Product Designer</h1>

      <div class="channel-row">
        <div class="channel">
          <Image src={portrait} alt="" width={40} height={40} densities={[1, 2]} class="avatar" loading="eager" />
          <div class="channel-text">
            <span class="channel-name">Jeremy Hamann</span>
            <span class="channel-sub">Senior Product Designer at Communify</span>
          </div>
          <div class="contact-btns">
            {telHref && <a class="pill-btn solid" href={telHref}>Call</a>}
            <a class="pill-btn solid" href={`mailto:${contact.email}`}>Email</a>
          </div>
        </div>
        <div class="actions">
          <a class="pill-btn soft" href={url(contact.resumePdf)} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Resume
          </a>
          <a class="pill-btn soft" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>

      <section class="description" aria-label="About">
        <p class="desc-meta">6+ years · Fintech & AI · Bank of America, Merrill, Charles Schwab, CommSec, Edward Jones</p>
        <p>I design products that people and institutions trust with their most sensitive assets and data. I lead design from research to launch, and lately that includes AI. Before design, I was a mental health counselor, and I bring that same empathy to every team I work with.</p>
      </section>

      <section class="comments" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="comments-count">{skills.length} Skills</h2>
        <ol class="comment-list">
          {skills.map((s) => (
            <li class="comment">
              <Image src={s.img} alt="" width={40} height={40} densities={[1, 2]} fit="cover" class="comment-avatar" />
              <div class="comment-body">
                <p class="comment-head"><span class="handle">@{s.skill}</span> <span class="comment-meta">· {s.project}</span></p>
                <p class="comment-text">{s.body}</p>
                <a class="comment-link" href={url(s.href)}>View case study</a>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="secondary" aria-labelledby="work-heading">
      <h2 id="work-heading" class="visually-hidden">Work</h2>
      <ul class="up-next">
        {projects.map((p) => (
          <li>
            <a class="next-item" href={url(`/${p.slug}`)}>
              <span class="thumb">
                <Image src={p.card} alt="" widths={[200, 400]} sizes="(max-width: 999px) 40vw, 168px" format="webp" />
                <span class="badge">{p.date.match(/\d{4}/g)?.at(-1)}</span>
              </span>
              <span class="next-text">
                <span class="next-title">{p.title}</span>
                <span class="pills">
                  {[...p.outcome.split(' · '), ...p.tags].map((t) => <span class="tag">{t}</span>)}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</Base>


<style>
  .watch { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 24px; padding-block: 0 48px; align-items: start; }
  .primary { display: grid; gap: 12px; min-width: 0; }

  .video { position: relative; aspect-ratio: 16 / 9; background: var(--panel-glass); display: grid; place-items: center; overflow: hidden; }
  .play { width: 72px; height: 72px; border-radius: 50%; border: 2px solid var(--ink); display: grid; place-items: center; padding-left: 4px; color: var(--ink); background: var(--panel); }
  .video-note { position: absolute; bottom: 12px; left: 16px; font-size: 12px; font-weight: 400; opacity: 0.7; }

  .video-title { font-size: 20px; font-weight: 700; line-height: 1.3; margin-top: 4px; }

  .channel-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
  .channel { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .channel-text { display: grid; line-height: 1.25; margin-right: 12px; }
  .channel-name { font-size: 16px; font-weight: 600; }
  .channel-sub { font-size: 12px; font-weight: 300; }
  .contact-btns, .actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .pill-btn { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 16px; font-size: 14px; font-weight: 500; text-decoration: none; white-space: nowrap; }
  .pill-btn.solid { background: var(--ink); color: var(--on-ink); }
  .pill-btn.soft { background: var(--panel); color: var(--ink); }
  .pill-btn:hover { text-decoration: none; filter: brightness(0.94); }
  .pill-btn.solid:hover { filter: brightness(1.2); }

  .description { background: var(--panel-glass); padding: 12px 14px; display: grid; gap: 6px; font-size: 14px; }
  .desc-meta { font-weight: 600; }

  .comments { margin-top: 16px; display: grid; gap: 20px; }
  .comments-count { font-size: 20px; font-weight: 700; }
  .comment-list { display: grid; gap: 20px; }
  .comment { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; }
  .comment-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: var(--panel); }
  .comment-body { display: grid; gap: 4px; }
  .comment-head { font-size: 13px; }
  .handle { font-weight: 600; }
  .comment-meta { font-weight: 300; }
  .comment-text { font-size: 14px; font-weight: 300; max-width: 720px; }
  .comment-link { font-size: 13px; font-weight: 600; justify-self: start; margin-top: 2px; }

  .secondary { display: grid; gap: 12px; min-width: 0; }
  .up-next { gap: 12px; }
  .up-next { display: grid; }
  .next-item { display: grid; grid-template-columns: 168px 1fr; gap: 10px; align-items: start; text-decoration: none; }
  .next-item:hover .next-title { text-decoration: underline; }
  .thumb { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--panel); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .next-item:hover .thumb :global(img) { transform: scale(1.04); }
  @media (prefers-reduced-motion: reduce) { .thumb :global(img) { transition: none; } }
  .badge { position: absolute; right: 4px; bottom: 4px; background: rgb(59 65 78 / 0.85); color: var(--on-ink); font-size: 12px; font-weight: 500; padding: 1px 4px; }
  .next-text { display: grid; gap: 2px; align-content: start; min-width: 0; }
  .next-title { font-size: 14px; font-weight: 600; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pills { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  .pills .tag { font-size: 11px; line-height: 14px; padding: 2px 6px; }

  /* Narrow screens: video, title and actions, then work, then skills. */
  @media (max-width: 999px) {
    .watch { grid-template-columns: 1fr; }
    .primary { display: contents; }
    .video, .video-title, .channel-row, .description { order: 0; }
    .secondary { order: 1; margin-top: 12px; }
    .comments { order: 2; }
  }
  @media (max-width: 799px) {
    .watch { padding-top: 0; }
    .next-item { grid-template-columns: 40% 1fr; }
    .play { width: 56px; height: 56px; }
  }
</style>
