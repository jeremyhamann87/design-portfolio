---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import CompanyLogo from '../components/CompanyLogo.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { projects } from '../data/projects';
import { url } from '../lib/url';
import gridIcon from '../assets/icons/view-grid.svg';
import tableIcon from '../assets/icons/view-table.svg';
import arrow from '../assets/icons/arrow-right.svg';

// Six skills, each linking to the case study that proves it.
const skills = [
  { skill: '0→1 product design', proof: 'Wealth portal launched in under 9 months', href: '/project-1-seven-post-client-portal' },
  { skill: 'AI product design', proof: 'AI note taking for financial advisors', href: '/project-4-ai-notetaker' },
  { skill: 'Data-dense UI', proof: 'Markets research for 3M customers', href: '/project-2-commsec' },
  { skill: 'Design systems', proof: 'A new MUI-based system for CommSec', href: '/project-2-commsec' },
  { skill: 'Research & testing', proof: 'Tested with clients and advisors', href: '/project-6-schwab-reports' },
  { skill: 'Responsive design', proof: 'Rules for 30+ data-heavy modules', href: '/project-5-schwab-trading' },
];

const tableOrder = ['project-4-ai-notetaker', 'project-3-advisor-dashboard', 'project-1-seven-post-client-portal', 'project-2-commsec', 'project-5-schwab-trading', 'project-6-schwab-reports'];
const tableRows = tableOrder.map((s) => projects.find((p) => p.slug === s)!);
---
<Base>
  <section class="wrap intro" aria-labelledby="hello">
    <div class="video-col">
      <h1 id="hello">Hello!</h1>
      <!-- Placeholder until the intro video is ready: swap this div for a <video> or embed. -->
      <div class="video" role="img" aria-label="Intro video coming soon">
        <span class="play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        </span>
        <span class="video-note">Intro video coming soon</span>
      </div>
    </div>

    <div class="skills-col">
      <h2 class="section-title">Skills</h2>
      <ul class="skills">
        {skills.map((s) => (
          <li>
            <a href={url(s.href)}>
              <span class="skill">{s.skill}</span>
              <span class="proof">{s.proof}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap work" aria-labelledby="my-work" data-view="grid">
    <div class="work-head">
      <h2 id="my-work" class="section-title">Work</h2>
      <div class="toggle glass" role="group" aria-label="Layout">
        <button type="button" data-set-view="grid" aria-pressed="true" aria-label="Grid view">
          <img src={gridIcon.src} alt="" width="20" height="18" />
        </button>
        <button type="button" data-set-view="table" aria-pressed="false" aria-label="Table view">
          <img src={tableIcon.src} alt="" width="20" height="16" />
        </button>
      </div>
    </div>

    <div class="grid glass">
      {projects.map((p) => <div class="cell"><WorkCard project={p} /></div>)}
    </div>

    <div class="table-wrap glass">
      <table>
        <thead>
          <tr><th scope="col">Project</th><th scope="col">Company</th><th scope="col">Result</th><th scope="col">Field</th><th scope="col"><span class="visually-hidden">Link</span></th></tr>
        </thead>
        <tbody>
          {tableRows.map((p) => (
            <tr>
              <th scope="row">{p.title}</th>
              <td><CompanyLogo company={p.company} label={p.byline} link={false} /></td>
              <td>{p.outcome}</td>
              <td>{p.field}</td>
              <td>
                <a class="btn" href={url(`/${p.slug}`)}>
                  View Project <img src={arrow.src} alt="" width="16" height="16" />
                  <span class="visually-hidden">: {p.title}</span>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <ContactCTA />
</Base>

<script>
  const section = document.querySelector<HTMLElement>('.work');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-view]');
  const KEY = 'work-view';
  function apply(view: string, persist = true) {
    if (!section) return;
    const v = view === 'table' ? 'table' : 'grid';
    section.dataset.view = v;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setView === v)));
    if (!persist) return;
    try { localStorage.setItem(KEY, v); } catch {}
    const u = new URL(location.href);
    if (v === 'table') u.searchParams.set('view', 'table'); else u.searchParams.delete('view');
    history.replaceState(null, '', u);
  }
  const fromUrl = new URLSearchParams(location.search).get('view');
  let stored: string | null = null;
  try { stored = localStorage.getItem(KEY); } catch {}
  apply(fromUrl ?? stored ?? 'grid', Boolean(fromUrl));
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.setView!)));
</script>

<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 36px; align-items: stretch; padding-block: 12px 48px; }
  .video-col, .skills-col { display: grid; gap: 16px; grid-template-rows: auto 1fr; }
  .skills-col .section-title { align-self: end; line-height: 1; padding-bottom: 6px; }
  h1 { font-size: var(--fs-display-xl); font-weight: 700; line-height: 1; }
  .section-title { font-size: 24px; font-weight: 400; }

  .video { position: relative; aspect-ratio: 16 / 9; border-radius: 8px; border: 1px solid var(--ink); background: var(--panel-glass); display: grid; place-items: center; overflow: hidden; }
  .play { width: 72px; height: 72px; border-radius: 50%; border: 2px solid var(--ink); display: grid; place-items: center; padding-left: 4px; color: var(--ink); background: var(--panel); }
  .video-note { position: absolute; bottom: 12px; left: 16px; font-size: 12px; font-weight: 400; opacity: 0.7; }

  .skills { display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; gap: 12px; }
  .skills a { display: grid; gap: 4px; height: 100%; padding: 14px 16px; align-content: center; border: 1px solid var(--ink); border-radius: 8px; background: var(--panel-glass); text-decoration: none; transition: background 0.15s, color 0.15s; }
  .skills a:hover, .skills a:focus-visible { background: var(--ink); color: var(--on-ink); }
  .skill { font-size: 16px; font-weight: 600; line-height: 1.2; }
  .proof { font-size: 13px; font-weight: 300; line-height: 1.3; }

  .work { padding-bottom: 48px; }
  .work-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .toggle { display: flex; }
  .toggle button { width: 40px; height: 40px; display: grid; place-items: center; border: 1px solid transparent; background: none; cursor: pointer; opacity: 0.45; }
  .toggle button[aria-pressed='true'] { border-color: var(--border); opacity: 1; }

  .grid { display: grid; grid-template-columns: 1fr 1fr; }
  .cell { padding: 36px; border-bottom: 1px solid var(--border); }
  .cell:nth-child(odd) { border-right: 1px solid var(--border); }
  .cell:nth-last-child(-n + 2) { border-bottom: 0; }

  .table-wrap { display: none; overflow-x: auto; }
  .work[data-view='table'] .grid { display: none; }
  .work[data-view='table'] .table-wrap { display: block; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 16px; border-bottom: 1px solid var(--border-soft); vertical-align: middle; }
  thead th { font-weight: 700; }
  tbody th { font-weight: 500; font-size: 16px; }
  td:last-child { text-align: right; }

  @media (max-width: 1000px) {
    .intro { grid-template-columns: 1fr; align-items: start; }
    .skills { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 799px) {
    .skills { grid-template-columns: 1fr 1fr; }
    .play { width: 56px; height: 56px; }
    .grid { grid-template-columns: 1fr; }
    .cell { padding: 24px 16px; border-right: 0 !important; border-bottom: 1px solid var(--border) !important; }
    .cell:last-child { border-bottom: 0 !important; }
    table, thead, tbody, tr, th, td { display: block; }
    thead { display: none; }
    tr { padding: 16px; border-bottom: 1px solid var(--border-soft); display: grid; gap: 8px; }
    th, td { padding: 0; border: 0; }
    td:last-child { text-align: left; margin-top: 4px; }
  }
</style>
