---
// Home, matching the Figma "Video Portfolio" design: intro video, contact row and bio,
// then tabs for My Skills / Work Experience / About Me, with the "My Work" list alongside.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { projects, homeOrder, contact, getProject } from '../data/projects';
import { skillIcons } from '../data/skill-icons';
import { url } from '../lib/url';
import portrait from '../assets/home/portrait.png';
import p1 from '../assets/about/photo-1.jpg';
import p2 from '../assets/about/photo-2.jpg';
import p3 from '../assets/about/photo-3.jpg';
import p4 from '../assets/about/photo-4.jpg';
import iEmail from '../assets/icons/contact-email.svg';
import iPhone from '../assets/icons/contact-phone.svg';
import iLocation from '../assets/icons/contact-location.svg';

const skills = [
  { skill: 'AI workflow automation', icon: 'menu_book', body: 'Automated our design documentation with Claude, turning annotated Figma designs into a 62-page build book and making documentation about 10x faster.', href: '/project-7-ai-design-documentation' },
  { skill: 'Interactive prototyping · Figma', icon: 'touch_app', body: 'Built a 100+ screen Figma prototype with 2,300+ interactions for MAI Capital Management’s advisor portal. Product, data and sales teams presented from it throughout one of Communify’s largest deals.', href: '/project-3-mai-advisor-portal' },
  { skill: 'AI product design', icon: 'auto_awesome', body: 'Designed an AI note taker that records, transcribes and suggests action items, with advisors approving or dismissing every one.', href: '/project-4-ai-notetaker' },
  { skill: 'Counseling & communication · Master’s-level training', icon: 'psychology', body: 'Trained to a master’s level as a counselor, with hands-on experience in communication styles, empathy and conflict resolution. I bring that to every design team as a steady, collaborative teammate who helps people feel heard.' },
  { skill: '0→1 product design', icon: 'rocket_launch', body: 'Took a wealth client portal from zero digital footprint to launch in under 9 months. It now carries $10B in assets and $1.5M in ARR.', href: '/project-1-seven-post-client-portal' },
  { skill: 'Data-dense UI', icon: 'monitoring', body: 'Turned global markets data into a research experience 3M CommSec customers can read at a glance.', href: '/project-2-commsec' },
  { skill: 'Design systems', icon: 'widgets', body: 'Built a new MUI-based system for Australia’s largest online broker, with modules that work on any platform or theme.', href: '/project-2-commsec' },
  { skill: 'Research & testing', icon: 'person_search', body: 'Ran dozens of test rounds with Schwab clients and advisors, then used affinity mapping to turn findings into layout changes.', href: '/project-6-schwab-reports' },
  { skill: 'Responsive design', icon: 'devices', body: 'Wrote the responsive rules for 30+ data-heavy trading modules and took Schwab’s research section from beta to production.', href: '/project-5-schwab-trading' },
];

const experience = [
  { org: 'Communify (Fincentric Acquisition)', role: 'Senior Product Designer', dates: '2023 – Present', body: 'Lead product design for client and advisor platforms used by Fortune 500 financial institutions, and manage design systems and a small team of designers.' },
  { org: 'S&P Global (IHS Markit Acquisition)', role: 'Product Designer', dates: '2020 – 2023', body: 'Designed bank onboarding flows and retail research platforms, turning complex compliance and market data into clear journeys.' },
  { org: 'Rewally', role: 'UX/UI Designer', dates: '2020', body: 'Designed a credit card rewards app for a startup, from concept to developer-ready handoff.' },
  { org: 'Aspen Counseling Group', role: 'Mental Health Counselor', dates: '2017 – 2019', body: 'Provided individual, couples and family counseling, and built a private practice.' },
  { org: 'Hat Creek Burger Company', role: 'Marketing Director', dates: '2014', body: 'Led marketing for a regional restaurant chain, growing brand awareness and foot traffic.' },
];
const education = 'Nielsen Norman Group UI/UX Certification (2024) · Flatiron School UI/UX Certification (2020) · St. Edward’s University, Master’s of Counseling · University of Nebraska-Lincoln, Bachelor’s of Journalism';

const work = homeOrder.map(getProject);
const photos = [p1, p2, p3, p4];
void projects;
---
<Base title="Jeremy Hamann - Senior Product Designer" description="Senior Product Designer in fintech and AI. Watch the intro, browse case studies, and get in touch.">
  <div class="wrap watch">
    <div class="primary">
      <!-- Placeholder until the intro video is ready: swap this div for a <video> or embed. -->
      <div class="video" role="img" aria-label="Intro video coming soon">
        <span class="play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        </span>
      </div>

      <h1 class="video-title">Hi, I’m Jeremy, your new Product Designer</h1>

      <div class="channel-row">
        <div class="channel">
          <Image src={portrait} alt="" width={40} height={40} densities={[1, 2]} class="avatar" loading="eager" />
          <div class="channel-text">
            <span class="channel-name">Jeremy Hamann</span>
            <span class="channel-sub">Senior Product Designer at Communify</span>
          </div>
        </div>
        <div class="actions">
          <a class="pill-btn solid" href={`mailto:${contact.email}`}>
            <svg viewBox="0 -960 960 960" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M172.31-180Q142-180 121-201q-21-21-21-51.31v-455.38Q100-738 121-759q21-21 51.31-21h615.38Q818-780 839-759q21 21 21 51.31v455.38Q860-222 839-201q-21 21-51.31 21H172.31ZM480-457.69 160-662.31v410q0 5.39 3.46 8.85t8.85 3.46h615.38q5.39 0 8.85-3.46t3.46-8.85v-410L480-457.69Zm0-62.31 313.85-200h-627.7L480-520Z"/></svg>
            Email Me
          </a>
          <a class="pill-btn soft" href={url(contact.resumePdf)} download="Jeremy-Hamann-Resume.pdf">
            <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path d="M9 3V11.25M12.375 7.875L9 11.25L5.625 7.875M3.75 14.25H14.25" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Resume
          </a>
          <a class="pill-btn soft" href={contact.linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.9274 13.9303H11.8542V10.6818C11.8542 9.90708 11.8385 8.91017 10.7739 8.91017C9.693 8.91017 9.52792 9.75308 9.52792 10.6246V13.9303H7.45475V7.25H9.44625V8.16058H9.47308C9.75133 7.63558 10.428 7.08142 11.4389 7.08142C13.5395 7.08142 13.928 8.46392 13.928 10.2635L13.9274 13.9303ZM5.11325 6.33592C4.44592 6.33592 3.90983 5.79575 3.90983 5.13133C3.90983 4.4675 4.4465 3.92792 5.11325 3.92792C5.77825 3.92792 6.31725 4.4675 6.31725 5.13133C6.31725 5.79575 5.77767 6.33592 5.11325 6.33592ZM6.15275 13.9303H4.07375V7.25H6.15275V13.9303ZM14.9646 2H3.03308C2.462 2 2 2.4515 2 3.00858V14.9914C2 15.5491 2.462 16 3.03308 16H14.9628C15.5333 16 16 15.5491 16 14.9914V3.00858C16 2.4515 15.5333 2 14.9628 2H14.9646Z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>

      <section class="description" aria-label="Summary">
        <p class="desc-meta">7 years · Fintech & AI · Bank of America, Merrill, Charles Schwab, CommSec, Edward Jones, S&P Global, Communify</p>
        <p>I design products that people and institutions trust with their most sensitive assets and data. I lead design from research to launch, and lately that includes AI. Before design, I was a mental health counselor, and I bring that same empathy to every team I work with.</p>
      </section>

      <section class="info-tabs" aria-label="About Jeremy">
        <div class="tab-bar" role="tablist" aria-label="Sections">
          <button type="button" role="tab" id="tab-skills" aria-controls="panel-skills" aria-selected="true">My Skills</button>
          <button type="button" role="tab" id="tab-work" aria-controls="panel-work" aria-selected="false" tabindex="-1">Work Experience</button>
          <button type="button" role="tab" id="tab-about" aria-controls="panel-about" aria-selected="false" tabindex="-1">About Me</button>
        </div>

        <div class="panel" role="tabpanel" id="panel-skills" aria-labelledby="tab-skills">
          <ul class="skills">
            {skills.map((s) => (
              <li class="skill">
                <span class="skill-icon" aria-hidden="true">
                  <svg viewBox="0 -960 960 960" width="20" height="20"><path fill="currentColor" d={skillIcons[s.icon]} /></svg>
                </span>
                <div class="skill-body">
                  <h3>{s.skill}</h3>
                  <p>{s.body}</p>
                  {s.href && <a class="skill-link" href={url(s.href)}>View case study</a>}
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="panel" role="tabpanel" id="panel-work" aria-labelledby="tab-work" hidden>
          <ol class="experience">
            {experience.map((e) => (
              <li>
                <div class="exp-top"><h3>{e.org} · {e.role}</h3><span class="dates">{e.dates}</span></div>
                <p>{e.body}</p>
              </li>
            ))}
          </ol>
          <p class="education"><strong>Education:</strong> {education.replace(/^Education: /, '')}</p>
          <a class="skill-link" href={url(contact.resumePdf)} download="Jeremy-Hamann-Resume.pdf">Download full resume (PDF)</a>
        </div>

        <div class="panel" role="tabpanel" id="panel-about" aria-labelledby="tab-about" hidden>
          <h3 class="about-hi">Hi, I’m Jeremy</h3>
          <div class="bio">
            <p>I’m a Senior Product Designer at Communify. I design end-to-end experiences for financial advisors and their clients, work that’s helped close multi-million dollar client relationships and scaled design systems across a growing product line. I believe personal finance is pivotal to life success, and that’s the story behind everything you’ll see here.</p>
            <p>Before design, I was a mental health counselor with master’s-level training in communication styles, empathy and conflict resolution. That’s what makes me a different kind of designer. I listen for what people actually need, I stay steady in hard conversations with stakeholders, and I help teams work through disagreement instead of around it.</p>
            <p>Outside of work, I’m a dad to two little girls. I love being outside, running, working out, painting, doing yoga and reading science fiction.</p>
          </div>
          <ul class="contact-row">
            <li><span class="mask-icon ci" style={`--icon:url(${iEmail.src})`} aria-hidden="true"></span><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><span class="mask-icon ci" style={`--icon:url(${iPhone.src})`} aria-hidden="true"></span><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></li>
            <li><span class="mask-icon ci" style={`--icon:url(${iLocation.src})`} aria-hidden="true"></span><span>{contact.location}</span></li>
          </ul>
          <div class="photos">
            {photos.map((p) => <Image src={p} alt="" widths={[300, 450]} sizes="(max-width: 799px) 45vw, 213px" format="webp" />)}
          </div>
        </div>
      </section>
    </div>

    <aside class="secondary" aria-labelledby="work-heading">
      <h2 id="work-heading" class="visually-hidden">My Work</h2>
      <ul class="up-next">
        {work.map((p) => (
          <li>
            <a class="next-item" href={url(`/${p.slug}`)}>
              <span class="thumb" style={p.cardBg ? `background:${p.cardBg}` : undefined}>
                <Image src={p.card} alt="" widths={[200, 400]} sizes="(max-width: 999px) 40vw, 168px" format="webp" />
                <span class="badge">{p.date.match(/\d{4}/g)?.at(-1)}</span>
              </span>
              <span class="next-text">
                <span class="next-title">{p.shortTitle ?? p.title}</span>
                <span class="next-blurb">{p.blurb}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</Base>

<script>
  // Accessible tabs: click or arrow keys switch panels.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.info-tabs [role="tab"]')];
  function select(t: HTMLButtonElement, focus = false) {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(x.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    });
    if (focus) t.focus();
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      }
    });
  });
</script>

<style>
  .watch { display: grid; grid-template-columns: minmax(0, 1fr) 356px; gap: 24px; padding-block: 0 48px; align-items: start; }
  @media (min-width: 1352px) { .watch { padding-inline: 0; } }
  .primary { display: grid; gap: 12px; min-width: 0; }

  .video { position: relative; aspect-ratio: 16 / 9; background: var(--panel-glass); border-radius: var(--r-module); display: grid; place-items: center; overflow: hidden; }
  .play { width: 72px; height: 72px; border-radius: 50%; border: 2px solid var(--ink); display: grid; place-items: center; padding-left: 4px; color: var(--ink); background: var(--panel); }

  .video-title { font-size: 20px; font-weight: 700; line-height: 1.3; margin-top: 4px; }

  .channel-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
  .channel { display: flex; align-items: center; gap: 12px; }
  .avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .channel-text { display: grid; line-height: 1.25; }
  .channel-name { font-size: 16px; font-weight: 600; }
  .channel-sub { font-size: 12px; font-weight: 300; text-decoration: underline; text-underline-offset: 2px; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .pill-btn { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 16px; border-radius: 8px; font-size: 14px; font-weight: 500; line-height: 19.6px; text-decoration: none; white-space: nowrap; }
  /* Email Me is the primary (ink) button; Resume and LinkedIn are light panels, as in Figma. */
  .pill-btn.solid { background: var(--ink); color: var(--on-ink); }
  .pill-btn.soft { background: var(--panel); color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .pill-btn:hover { text-decoration: none; filter: brightness(0.94); }

  .description { background: var(--panel-glass); border-radius: var(--r-module); padding: 12px 14px; display: grid; gap: 6px; font-size: 14px; }
  .desc-meta { font-weight: 600; }

  .info-tabs { margin-top: 20px; display: grid; gap: 24px; }
  .tab-bar { display: flex; gap: 32px; border-bottom: 1px solid var(--border-soft); }
  .tab-bar button { font: inherit; font-size: 20px; font-weight: 400; color: var(--ink); background: none; border: 0; padding: 0 0 8px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tab-bar button[aria-selected='true'] { font-weight: 600; border-bottom-color: var(--ink); }
  .panel { display: grid; gap: 20px; }
  .panel[hidden] { display: none; }

  .skills { display: grid; gap: 24px; }
  .skill { display: grid; grid-template-columns: 40px 1fr; gap: 12px; align-items: start; }
  .skill-icon { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--on-ink); }
  .skill-body { display: grid; gap: 4px; }
  .skill-body h3 { font-size: 14px; font-weight: 600; }
  .skill-body p { font-size: 14px; font-weight: 300; max-width: 760px; }
  .skill-link { font-size: 13px; font-weight: 600; justify-self: start; }

  .experience { display: grid; gap: 20px; }
  .exp-top { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .exp-top h3 { font-size: 16px; font-weight: 600; }
  .dates { font-size: 14px; font-weight: 300; }
  .experience p, .education { font-size: 14px; font-weight: 300; }

  .about-hi { font-size: 24px; font-weight: 700; }
  .bio { display: grid; gap: 12px; font-size: 16px; font-weight: 300; }
  .contact-row { display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 16px; font-weight: 300; }
  .contact-row li { display: inline-flex; align-items: center; gap: 8px; }
  .ci { width: 20px; height: 20px; }
  .photos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .photos :global(img) { width: 100%; aspect-ratio: 213 / 300; object-fit: cover; border-radius: var(--r-module); }

  .secondary { display: grid; gap: 12px; min-width: 0; }
  .work-heading { font-size: 20px; font-weight: 600; }
  .up-next { display: grid; gap: 24px; }
  .next-item { display: grid; grid-template-columns: 168px 1fr; gap: 10px; align-items: start; text-decoration: none; }
  .next-item:hover .next-title { text-decoration: underline dotted; text-decoration-thickness: 0.13em; text-underline-offset: 3px; }
  .thumb { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--r-module); background: var(--panel); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .next-item:hover .thumb :global(img) { transform: scale(1.04); }
  @media (prefers-reduced-motion: reduce) { .thumb :global(img) { transition: none; } }
  .badge { position: absolute; right: 4px; bottom: 4px; background: rgb(59 65 78 / 0.85); color: #ffffff; font-size: 12px; font-weight: 500; padding: 1px 4px; }
  .next-text { display: grid; gap: 4px; align-content: start; min-width: 0; }
  .next-title { font-size: 14px; font-weight: 600; line-height: 1.3; }
  .next-blurb { font-size: 12px; font-weight: 300; line-height: 1.35; }

  /* Narrow screens: video, title and actions, then work, then tabs. */
  @media (max-width: 999px) {
    .watch { grid-template-columns: 1fr; }
    .primary { display: contents; }
    .video, .video-title, .channel-row, .description { order: 0; }
    .secondary { order: 1; margin-top: 12px; }
    .info-tabs { order: 2; }
  }
  @media (max-width: 799px) {
    .next-item { grid-template-columns: 40% 1fr; }
    .play { width: 56px; height: 56px; }
    .tab-bar { gap: 20px; overflow-x: auto; }
    .tab-bar button { font-size: 16px; white-space: nowrap; }
    .photos { grid-template-columns: repeat(2, 1fr); }
  }
</style>
