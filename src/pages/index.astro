---
// Home, matching the Figma "Video Portfolio" design: intro video, contact row and bio,
// then tabs for My Skills / Work Experience / About Me, with the "My Work" list alongside.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { projects, homeOrder, contact, getProject } from '../data/projects';
import { skillIcons } from '../data/skill-icons';
import { url } from '../lib/url';
import portrait from '../assets/home/portrait.png';
import p1 from '../assets/about/photo-1.jpg';
import p2 from '../assets/about/photo-2.jpg';
import p3 from '../assets/about/photo-3.jpg';
import p4 from '../assets/about/photo-4.jpg';
import iEmail from '../assets/icons/contact-email.svg';
import iPhone from '../assets/icons/contact-phone.svg';
import iLocation from '../assets/icons/contact-location.svg';

const skills = [
  { skill: 'AI workflow automation', icon: 'menu_book', body: 'Automated our design documentation with Claude, turning annotated Figma designs into a 62-page build book and making documentation about 10x faster.', href: '/project-7-ai-design-documentation' },
  { skill: 'Interactive prototyping · Figma', icon: 'touch_app', body: 'Built a 100+ screen Figma prototype with 2,300+ interactions for MAI Capital Management’s advisor portal. Product, data and sales teams presented from it throughout one of Communify’s largest deals.', href: '/project-3-mai-advisor-portal' },
  { skill: 'AI product design · AI note taking', icon: 'auto_awesome', body: 'Designed an AI note taker that records, transcribes and suggests action items, with advisors approving or dismissing every one.', href: '/project-4-ai-notetaker' },
  { skill: 'Design systems', icon: 'widgets', body: 'Create and maintain dozens of Figma systems, like Glenmede’s 250+ component library with light and dark variables and docs for devs and PMs.', href: '/project-8-glenmede-design-system' },
  { skill: 'Counseling & communication · Master’s-level training', icon: 'psychology', body: 'Trained to a master’s level as a counselor, with hands-on experience in communication styles, empathy and conflict resolution. I bring that to every design team as a steady, collaborative teammate who helps people feel heard.' },
  { skill: '0→1 product design', icon: 'rocket_launch', body: 'Took a wealth client portal from zero digital footprint to launch in under 9 months. It now carries $10B in assets and $1.5M in ARR.', href: '/project-1-seven-post-client-portal' },
  { skill: 'Data-dense UI', icon: 'monitoring', body: 'Turned global markets data into a research experience 3M CommSec customers can read at a glance.', href: '/project-2-commsec' },
  { skill: 'Research & testing', icon: 'person_search', body: 'Ran dozens of test rounds with Schwab clients and advisors, then used affinity mapping to turn findings into layout changes.', href: '/project-6-schwab-reports' },
  { skill: 'Responsive design', icon: 'devices', body: 'Wrote the responsive rules for 30+ data-heavy trading modules and took Schwab’s research section from beta to production.', href: '/project-5-schwab-trading' },
];

const experience = [
  { org: 'Communify (Fincentric Acquisition)', role: 'Senior Product Designer', dates: '2023 – Present', body: 'Lead product design for client and advisor platforms used by Fortune 500 financial institutions, and manage design systems and a small team of designers.' },
  { org: 'S&P Global (IHS Markit Acquisition)', role: 'Product Designer', dates: '2020 – 2023', body: 'Designed bank onboarding flows and retail research platforms, turning complex compliance and market data into clear journeys.' },
  { org: 'Rewally', role: 'UX/UI Designer', dates: '2020', body: 'Designed a credit card rewards app for a startup, from concept to developer-ready handoff.' },
  { org: 'Aspen Counseling Group', role: 'Mental Health Counselor', dates: '2017 – 2019', body: 'Provided individual, couples and family counseling, and built a private practice.' },
  { org: 'Hat Creek Burger Company', role: 'Marketing Director', dates: '2014', body: 'Led marketing for a regional restaurant chain, growing brand awareness and foot traffic.' },
];
const education = 'Nielsen Norman Group UI/UX Certification (2024) · Flatiron School UI/UX Certification (2020) · St. Edward’s University, Master’s of Counseling · University of Nebraska-Lincoln, Bachelor’s of Journalism';

const work = homeOrder.map(getProject);
const photos = [p1, p2, p3, p4];
void projects;
---
<Base title="Jeremy Hamann - Senior Product Designer" description="Senior Product Designer in fintech and AI. Watch the intro, browse case studies, and get in touch.">
  <div class="wrap watch">
    <div class="primary">
      <div class="video">
        <video controls playsinline preload="metadata" poster={url('/media/intro-video-poster.webp')} aria-label="Intro video">
          <source src={url('/media/intro-video.mp4')} type="video/mp4" />
          <track kind="subtitles" src={url('/media/intro-video.en.vtt')} srclang="en" label="English" default />
        </video>
        <button type="button" class="play-btn" aria-label="Play intro video" hidden>
          <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true"><path fill="currentColor" d="M8 5.6v12.8c0 .8.9 1.3 1.6.8l10-6.4c.6-.4.6-1.2 0-1.6l-10-6.4C8.9 4.3 8 4.8 8 5.6Z"/></svg>
        </button>
        <button type="button" class="mute-btn" aria-label="Unmute" title="Mute / unmute (m)" hidden>
          <span class="when-muted"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M4 9.5v5c0 .6.4 1 1 1h3l4.3 3.6c.7.5 1.7.1 1.7-.8V5.7c0-.9-1-1.3-1.7-.8L8 8.5H5c-.6 0-1 .4-1 1Z"/><path d="m17 9.5 5 5m0-5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><span class="when-sound"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M4 9.5v5c0 .6.4 1 1 1h3l4.3 3.6c.7.5 1.7.1 1.7-.8V5.7c0-.9-1-1.3-1.7-.8L8 8.5H5c-.6 0-1 .4-1 1Z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M18.8 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
        </button>
        <div class="vbar" hidden>
          <button type="button" class="vbar-btn vbar-play" aria-label="Pause" title="Play / pause (k)">
            <span class="when-paused"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M8 5.6v12.8c0 .8.9 1.3 1.6.8l10-6.4c.6-.4.6-1.2 0-1.6l-10-6.4C8.9 4.3 8 4.8 8 5.6Z"/></svg></span><span class="when-playing"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z"/></svg></span>
          </button>
          <span class="vbar-time"><span class="vbar-cur">0:00</span> / <span class="vbar-dur">0:00</span></span>
          <input class="vbar-seek" type="range" min="0" max="1000" step="1" value="0" aria-label="Seek" />
          <button type="button" class="vbar-btn vbar-cc" aria-pressed="true" aria-label="Subtitles" title="Subtitles (c)"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10.5 10.2a2 2 0 1 0 0 3.6M16.5 10.2a2 2 0 1 0 0 3.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
          <button type="button" class="vbar-btn vbar-fs" aria-label="Full screen" title="Full screen (f)"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 9V5h4M20 9V5h-4M4 15v4h4M20 15v4h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      </div>

      <h1 class="video-title">Hi, I’m Jeremy, your new Product Designer</h1>

      <div class="channel-row">
        <div class="channel">
          <Image src={portrait} alt="" width={40} height={40} densities={[1, 2]} class="avatar" loading="eager" />
          <div class="channel-text">
            <span class="channel-name">Jeremy Hamann</span>
            <span class="channel-sub">Senior Product Designer at Communify</span>
          </div>
        </div>
        <div class="actions">
          <a class="pill-btn solid" href={`mailto:${contact.email}`}>
            <svg viewBox="0 -960 960 960" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M172.31-180Q142-180 121-201q-21-21-21-51.31v-455.38Q100-738 121-759q21-21 51.31-21h615.38Q818-780 839-759q21 21 21 51.31v455.38Q860-222 839-201q-21 21-51.31 21H172.31ZM480-457.69 160-662.31v410q0 5.39 3.46 8.85t8.85 3.46h615.38q5.39 0 8.85-3.46t3.46-8.85v-410L480-457.69Zm0-62.31 313.85-200h-627.7L480-520Z"/></svg>
            Email Me
          </a>
          <a class="pill-btn soft" href={url(contact.resumePdf)} data-resume-viewer aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V7.5L14 3zM14 3v4.5h4.5M9 12.5h6M9 16h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Resume
          </a>
          <a class="pill-btn soft" href={contact.linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.9274 13.9303H11.8542V10.6818C11.8542 9.90708 11.8385 8.91017 10.7739 8.91017C9.693 8.91017 9.52792 9.75308 9.52792 10.6246V13.9303H7.45475V7.25H9.44625V8.16058H9.47308C9.75133 7.63558 10.428 7.08142 11.4389 7.08142C13.5395 7.08142 13.928 8.46392 13.928 10.2635L13.9274 13.9303ZM5.11325 6.33592C4.44592 6.33592 3.90983 5.79575 3.90983 5.13133C3.90983 4.4675 4.4465 3.92792 5.11325 3.92792C5.77825 3.92792 6.31725 4.4675 6.31725 5.13133C6.31725 5.79575 5.77767 6.33592 5.11325 6.33592ZM6.15275 13.9303H4.07375V7.25H6.15275V13.9303ZM14.9646 2H3.03308C2.462 2 2 2.4515 2 3.00858V14.9914C2 15.5491 2.462 16 3.03308 16H14.9628C15.5333 16 16 15.5491 16 14.9914V3.00858C16 2.4515 15.5333 2 14.9628 2H14.9646Z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>

      <section class="description" aria-label="Summary">
        <p class="desc-meta">7 years · Fintech & AI · Bank of America, Merrill, Charles Schwab, CommSec, Edward Jones, S&P Global, Communify</p>
        <p>I design products that people and institutions trust with their most sensitive assets and data. I lead design from research to launch, and lately that includes AI. Before design, I was a mental health counselor, and I bring that same empathy to every team I work with.</p>
      </section>

      <section class="info-tabs" aria-label="About Jeremy">
        <div class="tab-bar" role="tablist" aria-label="Sections">
          <button type="button" role="tab" id="tab-skills" aria-controls="panel-skills" aria-selected="true">My Skills</button>
          <button type="button" role="tab" id="tab-work" aria-controls="panel-work" aria-selected="false" tabindex="-1">Work Experience</button>
          <button type="button" role="tab" id="tab-about" aria-controls="panel-about" aria-selected="false" tabindex="-1">About Me</button>
        </div>

        <div class="panel" role="tabpanel" id="panel-skills" aria-labelledby="tab-skills">
          <ul class="skills">
            {skills.map((s) => (
              <li class="skill">
                <span class="skill-icon" aria-hidden="true">
                  <svg viewBox="0 -960 960 960" width="24" height="24"><path fill="currentColor" d={skillIcons[s.icon]} /></svg>
                </span>
                <div class="skill-body">
                  <h3>{s.skill}</h3>
                  <p>{s.body}</p>
                  {s.href && <a class="skill-link" href={url(s.href)}>View case study</a>}
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="panel" role="tabpanel" id="panel-work" aria-labelledby="tab-work" hidden>
          <ol class="experience">
            {experience.map((e) => (
              <li>
                <div class="exp-top"><h3>{e.org} · {e.role}</h3><span class="dates">{e.dates}</span></div>
                <p>{e.body}</p>
              </li>
            ))}
          </ol>
          <p class="education"><strong>Education:</strong> {education.replace(/^Education: /, '')}</p>
          <a class="skill-link resume-link" href={url(contact.resumePdf)} download="Jeremy Hamann Senior Product Designer.pdf">Download full resume (PDF)</a>
        </div>

        <div class="panel" role="tabpanel" id="panel-about" aria-labelledby="tab-about" hidden>
          <h3 class="about-hi">Hi, I’m Jeremy</h3>
          <div class="bio">
            <p>I’m a Senior Product Designer at Communify. I design end-to-end experiences for financial advisors and their clients, work that’s helped close multi-million dollar client relationships and scaled design systems across a growing product line. I believe personal finance is pivotal to life success, and that’s the story behind everything you’ll see here.</p>
            <p>Before design, I was a mental health counselor with master’s-level training in communication styles, empathy and conflict resolution. That’s what makes me a different kind of designer. I listen for what people actually need, I stay steady in hard conversations with stakeholders, and I help teams work through disagreement instead of around it.</p>
            <p>Outside of work, I’m a dad to two little girls. I love being outside, running, working out, painting, doing yoga and reading science fiction.</p>
          </div>
          <ul class="contact-row">
            <li><span class="mask-icon ci" style={`--icon:url(${iEmail.src})`} aria-hidden="true"></span><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><span class="mask-icon ci" style={`--icon:url(${iPhone.src})`} aria-hidden="true"></span><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></li>
            <li><span class="mask-icon ci" style={`--icon:url(${iLocation.src})`} aria-hidden="true"></span><span>{contact.location}</span></li>
          </ul>
          <div class="photos">
            {photos.map((p) => <Image src={p} alt="" widths={[300, 450]} sizes="(max-width: 799px) 45vw, 213px" format="webp" />)}
          </div>
        </div>
      </section>
    </div>

    <aside class="secondary" aria-labelledby="work-heading">
      <h2 id="work-heading" class="visually-hidden">My Work</h2>
      <ul class="up-next">
        {work.map((p) => (
          <li>
            <a class="next-item" href={url(`/${p.slug}`)} style={p.hue !== undefined ? `--hue:${p.hue}` : undefined}>
              <span class="thumb" style={p.thumb ? undefined : p.cardBg ? `background:${p.cardBg}` : undefined}>
                <Image class={p.thumbDark ? 'only-light' : undefined} src={p.thumb ?? p.card} alt="" widths={[200, 400, 668]} sizes="(max-width: 999px) 40vw, 168px" format="webp" />
                {p.thumbDark && <Image class="only-dark" src={p.thumbDark} alt="" widths={[200, 400, 668]} sizes="(max-width: 999px) 40vw, 168px" format="webp" />}
                <span class="badge">{p.date.match(/\d{4}/g)?.at(-1)}</span>
              </span>
              <span class="next-text">
                <span class="next-title">{p.shortTitle ?? p.title}</span>
                <span class="next-blurb">{p.blurb}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</Base>

<script>
  // Intro video player. Before the first play: a big play button over the poster, a silent preview
  // on hover (desktop only) and a mute toggle. After it: a custom control bar with play, seek,
  // subtitles (on by default) and full screen. Without JS the native controls stay.
  const video = document.querySelector<HTMLVideoElement>('.video video');
  const wrap = video?.parentElement;
  if (video && wrap) {
    const q = <T extends Element>(sel: string) => wrap.querySelector<T>(sel)!;
    const playBtn = q<HTMLButtonElement>('.play-btn');
    const muteBtn = q<HTMLButtonElement>('.mute-btn');
    const bar = q<HTMLDivElement>('.vbar');
    const barPlay = q<HTMLButtonElement>('.vbar-play');
    const ccBtn = q<HTMLButtonElement>('.vbar-cc');
    const fsBtn = q<HTMLButtonElement>('.vbar-fs');
    const seek = q<HTMLInputElement>('.vbar-seek');
    const cur = q<HTMLSpanElement>('.vbar-cur');
    const dur = q<HTMLSpanElement>('.vbar-dur');
    const canPreview = matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const track = () => video.textTracks[0];
    const fmt = (t: number) => { t = Math.max(0, Math.floor(t || 0)); return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`; };
    let engaged = false;
    let previewing = false;
    let hideTimer = 0;

    video.controls = false;
    playBtn.hidden = false;
    muteBtn.hidden = false;
    bar.hidden = false;
    wrap.classList.add('idle');
    wrap.tabIndex = -1;
    if (track()) track()!.mode = 'showing';
    // Lift subtitles above the control bar.
    const liftCues = () => { const cues = track()?.cues; if (cues) for (const c of Array.from(cues) as VTTCue[]) { c.snapToLines = false; c.line = 84; c.lineAlign = "end"; } };
    wrap.querySelector('track')?.addEventListener('load', liftCues);
    liftCues();

    const sync = () => {
      const muted = video.muted;
      wrap.classList.toggle('muted', muted);
      muteBtn.setAttribute('aria-label', muted ? 'Unmute' : 'Mute');
      wrap.classList.toggle('playing', !video.paused);
      barPlay.setAttribute('aria-label', video.paused ? 'Play' : 'Pause');
      ccBtn.setAttribute('aria-pressed', String(track()?.mode === 'showing'));
      cur.textContent = fmt(video.currentTime);
      if (video.duration) {
        dur.textContent = fmt(video.duration);
        if (document.activeElement !== seek) seek.value = String(Math.round((video.currentTime / video.duration) * 1000));
      }
      seek.style.setProperty('--fill', `${Number(seek.value) / 10}%`);
    };
    // Keep the bar up while the pointer moves or the video is paused, like YouTube.
    const wake = () => {
      wrap.classList.add('active');
      clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => { if (!video.paused && !bar.contains(document.activeElement)) wrap.classList.remove('active'); }, 2500);
    };

    const start = () => {
      engaged = true;
      previewing = false;
      wrap.classList.remove('idle', 'previewing');
      wrap.classList.add('engaged');
      video.muted = false;
      video.currentTime = 0;
      video.play().catch(() => {});
      wrap.focus({ preventScroll: true });
      wake();
    };
    const togglePlay = () => { if (!engaged) return start(); video.paused ? video.play().catch(() => {}) : video.pause(); wake(); };
    const toggleMute = () => { video.muted = !video.muted; sync(); };
    const toggleCC = () => { const t = track(); if (t) { t.mode = t.mode === 'showing' ? 'hidden' : 'showing'; sync(); } };
    const toggleFs = () => {
      if (document.fullscreenElement) return void document.exitFullscreen();
      if (wrap.requestFullscreen) return void wrap.requestFullscreen().catch(() => {});
      (video as HTMLVideoElement & { webkitEnterFullscreen?: () => void }).webkitEnterFullscreen?.();
    };

    playBtn.addEventListener('click', start);
    video.addEventListener('click', togglePlay);
    barPlay.addEventListener('click', togglePlay);
    muteBtn.addEventListener('click', toggleMute);
    ccBtn.addEventListener('click', toggleCC);
    fsBtn.addEventListener('click', toggleFs);
    seek.addEventListener('input', () => {
      if (video.duration) video.currentTime = (Number(seek.value) / 1000) * video.duration;
      sync();
    });
    wrap.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement && e.key.startsWith('Arrow')) return;
      const k = e.key.toLowerCase();
      if (k === 'k' || (k === ' ' && !(e.target instanceof HTMLButtonElement))) { e.preventDefault(); togglePlay(); }
      else if (k === 'm') toggleMute();
      else if (k === 'c') toggleCC();
      else if (k === 'f' && engaged) toggleFs();
    });
    wrap.addEventListener('mousemove', () => { if (engaged) wake(); });
    wrap.addEventListener('focusin', () => { if (engaged) wake(); });
    ['play', 'pause', 'timeupdate', 'loadedmetadata', 'volumechange', 'durationchange'].forEach((ev) => video.addEventListener(ev, sync));
    video.textTracks.addEventListener('change', sync);
    video.addEventListener('pause', () => { if (engaged) wake(); });

    if (canPreview) {
      wrap.addEventListener('mouseenter', () => {
        if (engaged) return;
        previewing = true;
        wrap.classList.add('previewing');
        video.muted = true;
        video.play().catch(() => {});
      });
      wrap.addEventListener('mouseleave', () => {
        if (engaged) { wrap.classList.remove('active'); return; }
        if (!previewing) return;
        previewing = false;
        wrap.classList.remove('previewing');
        video.pause();
        video.currentTime = 0;
      });
    }
    sync();
  }

  // Accessible tabs: click or arrow keys switch panels.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.info-tabs [role="tab"]')];
  function select(t: HTMLButtonElement, focus = false) {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(x.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    });
    if (focus) t.focus();
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      }
    });
  });
</script>

<style>
  .watch { display: grid; grid-template-columns: minmax(0, 1fr) 356px; gap: 24px; padding-block: 0 48px; align-items: start; }
  @media (min-width: 1352px) { .watch { padding-inline: 0; } }
  .primary { display: grid; gap: 16px; min-width: 0; }

  .video { position: relative; aspect-ratio: 16 / 9; background: var(--panel-glass); border-radius: var(--r-module); display: grid; place-items: center; overflow: hidden; }
  .video video { width: 100%; height: 100%; object-fit: cover; display: block; background: #000; }
  .mute-btn { position: absolute; top: 12px; right: 12px; width: 40px; height: 40px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: rgba(0, 0, 0, 0.5); color: #fff; cursor: pointer; opacity: 0; transition: opacity 0.2s ease, background-color 0.2s ease; z-index: 2; }
  .mute-btn[hidden], .vbar[hidden] { display: none; }
  .mute-btn:hover { background: rgba(0, 0, 0, 0.7); }
  .video.previewing .mute-btn, .video.engaged.active .mute-btn, .video.engaged:not(.playing) .mute-btn, .mute-btn:focus-visible { opacity: 1; }
  .video .when-sound, .video.muted .when-muted { display: contents; }
  .video .when-muted, .video.muted .when-sound { display: none; }
  .play-btn { position: absolute; top: 50%; left: 50%; width: 76px; height: 76px; margin: -38px 0 0 -38px; display: grid; place-items: center; padding: 0 0 0 4px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.94); color: #111; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.28); cursor: pointer; transition: transform 0.2s ease, opacity 0.2s ease, background-color 0.2s ease; }
  .play-btn[hidden] { display: none; }
  .play-btn:hover { transform: scale(1.08); background: #fff; }
