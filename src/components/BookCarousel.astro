---
// "Book carousel" / "Docs carousel" from Figma: a 996px square colored panel with one 777px page,
// a caption and counter under it, and round prev/next buttons. Sits inside a dark band.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { pages: { img: ImageMetadata; caption: string; alt: string }[]; bg: string; fit?: 'cover' | 'contain'; label: string; pb?: number; bgDark?: string }
const { pages, bg, bgDark = bg, fit = 'cover', label, pb = 48 } = Astro.props;
---
<div class="wrap" style={`--cpb:${pb}px`}>
  <div class:list={['carousel', fit]} style={`--cbg:${bg};--cbg-dark:${bgDark}`} role="region" aria-roledescription="carousel" aria-label={label} data-carousel>
    {pages.map((pg, i) => (
      <figure class="slide" data-slide hidden={i !== 0} aria-label={`${i + 1} of ${pages.length}`}>
        <div class="page"><Image src={pg.img} alt={pg.alt} widths={[480, 780, 1200, 1600]} sizes="(max-width: 1040px) 78vw, 777px" format="webp" loading={i === 0 ? 'eager' : 'lazy'} /></div>
        <figcaption><span class="cap">{pg.caption}</span><span class="count">{i + 1} / {pages.length}</span></figcaption>
      </figure>
    ))}
    <button class="nav prev" type="button" aria-label="Previous page" data-prev><svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <button class="nav next" type="button" aria-label="Next page" data-next><svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  </div>
</div>

<style>
  .wrap { padding: 0 var(--band-pad) var(--cpb); }
  .carousel { position: relative; background: var(--cbg); max-width: 996px; margin-inline: auto; padding: 4.82% 11.04% 0; aspect-ratio: 1; color: #3b414e; }
  :global(:root[data-theme='dark']) .carousel { background: var(--cbg-dark); color: #e6e9ef; }
  .slide { display: grid; gap: clamp(12px, 4vw, 40px); margin: 0; }
  .slide[hidden] { display: none; }
  .page { aspect-ratio: 1; overflow: hidden; background: #fff; box-shadow: 0 4px 12px rgb(0 0 0 / 0.15); }
  .page :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .contain .page :global(img) { object-fit: contain; object-position: center; }
  figcaption { display: flex; justify-content: space-between; gap: 16px; font-size: clamp(14px, 2.2vw, 22px); line-height: 1.2; }
  .cap { font-weight: 600; }
  .count { font-weight: 400; white-space: nowrap; }
  .nav { position: absolute; top: 45.18%; width: 56px; height: 56px; border-radius: 50%; border: 0; display: grid; place-items: center; background: #3b414e; color: #f8fcff; cursor: pointer; }
  .nav:hover { filter: brightness(1.15); }
  .prev { left: 2.4%; }
  .next { right: 2.4%; }
  @media (max-width: 767px) {
    .wrap { padding-inline: 0; }
    .nav { width: 36px; height: 36px; }
    .nav svg { width: 22px; height: 22px; }
    .prev { left: 1.5%; }
    .next { right: 1.5%; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    let i = 0;
    const show = (n: number) => {
      slides[i].hidden = true;
      i = (n + slides.length) % slides.length;
      slides[i].hidden = false;
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1));
    root.tabIndex = 0;
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
  });
</script>
