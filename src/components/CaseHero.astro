---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';
import CompanyLogo from './CompanyLogo.astro';

interface Props { project: Project; image: ImageMetadata; bg: string; alt?: string; full?: boolean }
const { project: p, image, bg, alt = '', full = false } = Astro.props;
---
<section class:list={['hero', { full }]} style={`--band:${bg}`}>
  <div class="wrap-case inner">
    <div class="text">
      <h1>{p.title}</h1>
      <CompanyLogo company={p.company} label={p.byline} />
      <ul class="tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
      <p class="date">{p.date}</p>
    </div>
    <div class="art">
      <Image src={image} alt={alt} widths={[600, 900, 1400, 2000]} sizes="(max-width: 799px) 100vw, 60vw" format="webp" loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>

<style>
  .hero { background: var(--band); overflow: hidden; }
  .inner { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(0, 1.4fr); align-items: center; gap: 36px; min-height: 500px; padding-block: 36px; }
  .text { display: grid; gap: 16px; justify-items: start; }
  h1 { font-size: var(--fs-display); font-weight: 700; line-height: 1.15; }
  .date { font-size: 14px; font-weight: 300; }
  .tag { background: var(--panel); }
  .art :global(img) { width: 100%; max-height: 460px; object-fit: contain; }
  @media (max-width: 799px) {
    .inner { grid-template-columns: 1fr; min-height: 0; padding-block: 24px 36px; }
    .art { order: -1; }
    .art :global(img) { max-height: 320px; }
  }
</style>
