---
// "Case study hero" from Figma. Desktop: 1000x500 card (8px radius, shadow) with copy left and art right.
// Tablet: full-width 360px band. Mobile: full-width band with the copy only.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';
import CompanyLogo from './CompanyLogo.astro';

interface Props { project: Project; image?: ImageMetadata; bg: string; alt?: string; title?: string; artWidth?: number; textWidth?: number; gap?: number; bleed?: boolean }
const { project: p, image, bg, alt = '', title, artWidth = 440, textWidth = 414, gap = 29, bleed = false } = Astro.props;
const lines = (title ?? p.title).split('\n');
---
<section class:list={['hero', { bleed }]} style={`--band:${bg};--art-w:${artWidth}px;--text-w:${textWidth}px;--hgap:${gap}px`}>
  <div class="text">
    <h1>{lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
    <CompanyLogo company={p.company} label={p.byline} />
    <ul class="tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
    <p class="date">{p.date}</p>
  </div>
  <div class="art">
    <slot name="art">
      {image && <Image src={image} alt={alt} widths={[600, 900, 1400]} sizes="(max-width: 1040px) 50vw, 440px" format="webp" loading="eager" fetchpriority="high" />}
    </slot>
  </div>
</section>

<style>
  .hero {
    width: var(--case-w);
    margin-inline: auto;
    min-height: 500px;
    background: var(--band);
    border-radius: var(--r-module);
    box-shadow: var(--module-shadow);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hgap);
    padding: 0 100px;
    overflow: hidden;
  }
  .text { flex: 0 1 var(--text-w); display: grid; gap: 16px; justify-items: start; }
  h1 { font-size: 36px; font-weight: 700; line-height: 43px; }
  .tags { gap: 8px; }
  .tag { font-size: 16px; line-height: 19px; font-weight: 300; padding: 4px 8px; border-radius: 1000px; background: var(--panel); }
  .date { font-size: 16px; font-weight: 200; }
  .art { flex: 0 1 var(--art-w); align-self: stretch; display: flex; align-items: center; justify-content: center; position: relative; }
  .art :global(img) { width: 100%; max-height: 456px; object-fit: contain; }
  .bleed .art :global(img) { max-height: none; height: 100%; }
  @media (max-width: 1040px) {
    .hero { min-height: 360px; height: 360px; border-radius: 0; padding: 0 36px; }
    .text { flex-basis: 340px; }
    h1 { font-size: 32px; line-height: 38px; }
    .art :global(img) { max-height: 320px; }
    .bleed .art :global(img) { height: 140%; max-height: none; }
  }
  @media (max-width: 767px) {
    .hero { height: auto; min-height: 0; padding: 48px 24px; }
    .text { flex-basis: 100%; gap: 12px; }
    h1 { font-size: 28px; line-height: 34px; }
    .art { display: none; }
  }
</style>
