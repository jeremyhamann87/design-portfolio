---
interface Props { problem: string; role: string; result: string; decisions: string[] }
const { problem, role, result, decisions } = Astro.props;
---
<section class="summary" aria-label="Project summary">
  <div class="wrap-case">
    <dl class="tldr">
      <div><dt>Problem</dt><dd>{problem}</dd></div>
      <div><dt>My role</dt><dd>{role}</dd></div>
      <div class="result"><dt>Result</dt><dd>{result}</dd></div>
    </dl>
    <div class="decisions">
      <h2>Decisions I drove</h2>
      <ol>{decisions.map((d) => <li>{d}</li>)}</ol>
    </div>
  </div>
</section>
<style>
  .summary { padding-block: 36px; background: var(--panel); border-bottom: 1px solid var(--border-soft); }
  .tldr { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 0 0 28px; }
  .tldr > div { display: grid; gap: 6px; align-content: start; padding-top: 12px; border-top: 2px solid var(--ink); }
  dt { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  dd { margin: 0; font-size: 16px; font-weight: 400; line-height: 1.4; }
  .result dd { font-weight: 600; }
  h2 { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 12px; }
  ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; counter-reset: d; }
  li { counter-increment: d; position: relative; padding: 16px 16px 16px 52px; background: var(--surface); border: 1px solid var(--border-soft); font-weight: 300; }
  li::before { content: counter(d, decimal-leading-zero); position: absolute; left: 16px; top: 15px; font-weight: 700; }
  @media (max-width: 799px) { .tldr { grid-template-columns: 1fr; } }
</style>
