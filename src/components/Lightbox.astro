<dialog class="lightbox" aria-label="Expanded image">
  <button class="lb-close" type="button" aria-label="Close image">
    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  </button>
  <img alt="" />
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const img = dlg?.querySelector('img');
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-zoom]');
    if (!t || !dlg || !img) return;
    img.src = t.dataset.zoom!;
    img.alt = t.querySelector('img')?.alt ?? '';
    dlg.showModal();
  });
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg || (e.target as HTMLElement).closest('.lb-close')) dlg.close();
  });
</script>

<style>
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 96vh; overflow: visible; }
  .lightbox::backdrop { background: rgb(59 65 78 / 0.85); }
  .lightbox img { max-width: 96vw; max-height: 92vh; width: auto; height: auto; border-radius: 4px; background: #fff; }
  .lb-close { position: fixed; top: 16px; right: 16px; background: #fff; color: var(--ink); border: 0; border-radius: 1000px; width: 40px; height: 40px; display: grid; place-items: center; cursor: pointer; }
</style>
