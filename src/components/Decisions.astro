---
// "The Big Decisions Along the Way" / "Key Decisions" module: the Icon module with
// Case Study / Decision rows (thin dividers between decisions, constraint | trade-off).
import Module from './Module.astro';
interface Decision { title: string; constraint: string; tradeoff: string }
interface Props { items: Decision[]; title?: string; numbered?: boolean; weight?: 500 | 700 }
const { items, title = 'Key Decisions', numbered = false, weight = 700 } = Astro.props;
---
<Module title={title} icon="balance" flush id="key-decisions">
  <ol class="decisions" style={`--dw:${weight}`}>
    {items.map((d, i) => (
      <li class="decision">
        <h3>{numbered && <>{String(i + 1).padStart(2, '0')} </>}{d.title}</h3>
        <div class="details">
          <div class="col constraint"><h4>Constraint</h4><p>{d.constraint}</p></div>
          <div class="col"><h4>Trade-off</h4><p>{d.tradeoff}</p></div>
        </div>
      </li>
    ))}
  </ol>
</Module>
<style>
  .decision { display: grid; gap: 16px; padding: 24px; border-bottom: 1px solid var(--border); }
  .decision:last-child { border-bottom: 0; }
  h3, h4 { font-size: 16px; font-weight: var(--dw); line-height: 19px; }
  .details { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .col { display: grid; gap: 6px; align-content: start; }
  .constraint { padding-right: 16px; border-right: 1px solid var(--border); }
  @media (max-width: 767px) {
    .details { grid-template-columns: 1fr; gap: 16px; }
    .constraint { padding-right: 0; border-right: 0; }
  }
</style>
