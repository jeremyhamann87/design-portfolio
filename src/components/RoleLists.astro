---
// "Role and Collaboartion" component from Figma: two columns, Medium headings, dotted lists.
interface Props { role: string[]; collaborators: string[]; columnsOnMobile?: boolean }
const { role, collaborators, columnsOnMobile = false } = Astro.props;
---
<div class:list={['roles', { cols: columnsOnMobile }]}>
  <div class="col"><h3>My Role</h3><ul>{role.map((r) => <li>{r}</li>)}</ul></div>
  <div class="col"><h3>I Collaborated With</h3><ul>{collaborators.map((r) => <li>{r}</li>)}</ul></div>
</div>
<style>
  .roles { display: grid; grid-template-columns: 1fr 1fr; align-items: center; }
  .col { display: grid; gap: 12px; align-content: start; }
  h3 { font-size: 16px; font-weight: 500; line-height: 19px; }
  ul { display: grid; gap: 8px; list-style: none; padding-left: 0; }
  li { position: relative; padding-left: 20px; line-height: 19px; }
  li::before { content: '·'; position: absolute; left: 8px; font-weight: 700; }
  @media (max-width: 767px) { .roles { grid-template-columns: 1fr; gap: 24px; } .roles.cols { grid-template-columns: 1fr 1fr; gap: 0; align-items: start; } }
</style>
