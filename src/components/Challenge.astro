---
// "Challenge" card from Figma: problem (peach), a "Solved Via" chip on a looping arrow, solution (lime).
import loop from '../assets/icons/loop-arrow.svg';
interface Props { title: string; body: string; solvedTitle: string; solvedBody: string }
const { title, body, solvedTitle, solvedBody } = Astro.props;
---
<div class="challenge">
  <div class="part">
    <h3 class="problem">{title}</h3>
    <p>{body}</p>
  </div>
  <div class="solved" aria-hidden="true">
    <span class="arrow mask-icon" style={`--icon:url(${loop.src})`}></span>
    <span class="chip">Solved Via</span>
  </div>
  <div class="part">
    <h4 class="solution"><span class="visually-hidden">Solved via: </span>{solvedTitle}</h4>
    <p>{solvedBody}</p>
  </div>
</div>
<style>
  .challenge { display: grid; gap: 8px; align-content: start; padding: 0 36px 36px 0; border-right: 1px solid rgb(248 252 255 / 0.5); }
  .challenge:last-child { border-right: 0; }
  .part { display: grid; gap: 16px; }
  h3, h4 { font-size: 16px; font-weight: 700; line-height: 19px; text-transform: uppercase; }
  .problem { color: var(--eyebrow-peach); }
  .solution { color: var(--eyebrow-lime); }
  p { color: #f8fcff; }
  .solved { position: relative; width: 93px; height: 87px; justify-self: center; display: grid; place-items: center; }
  .arrow { position: absolute; width: 63px; height: 14px; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(90deg); color: #f8fcff; }
  .chip { position: relative; background: #f8fcff; color: #000; font-size: 12px; font-weight: 700; line-height: 14px; padding: 8px; }
  @media (max-width: 1040px) {
    .challenge { padding: 0 0 36px; border-right: 0; }
  }
</style>
