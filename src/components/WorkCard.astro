---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import CompanyLogo from './CompanyLogo.astro';
import { url } from '../lib/url';

interface Props { project: Project; size?: 'large' | 'small'; headingLevel?: 'h2' | 'h3' }
const { project: p, size = 'large', headingLevel: H = 'h3' } = Astro.props;
---
<article class:list={['card', size]}>
  <a class="media" href={url(`/${p.slug}`)} tabindex="-1" aria-hidden="true">
    <Image src={p.card} alt="" widths={[400, 600, 900, 1200]} sizes="(max-width: 799px) 100vw, 568px" format="webp" />
  </a>
  <div class="body">
    <H class="title"><a href={url(`/${p.slug}`)}>{p.title}</a></H>
    <p class="outcome">{p.outcome}</p>
    <p class="desc">{p.description}</p>
    <CompanyLogo company={p.company} link={false} label={p.byline} />
    {size === 'large' && (
      <ul class="tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
    )}
  </div>
</article>

<style>
  .card { display: grid; gap: 16px; align-content: start; position: relative; }
  .media { display: block; overflow: hidden; border-radius: 4px; }
  .media :global(img) { width: 100%; aspect-ratio: 568 / 394; object-fit: cover; transition: transform 0.3s ease; }
  .card:hover .media :global(img) { transform: scale(1.02); }
  @media (prefers-reduced-motion: reduce) { .card:hover .media :global(img) { transform: none; } }
  .body { display: grid; gap: 12px; }
  .title { font-size: 24px; font-weight: 500; line-height: 1.2; }
  .small .title { font-size: 20px; }
  .title a { text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .title a:hover { text-decoration: underline; }
  .desc { font-weight: 300; }
  .outcome { font-size: 14px; font-weight: 600; letter-spacing: 0.01em; padding: 6px 10px; background: var(--ink); color: var(--on-ink); border-radius: 4px; justify-self: start; }
  .small .outcome { font-size: 13px; }
  .tags { position: relative; }
</style>
