---
import { contact } from '../data/projects';
import { url } from '../lib/url';
interface Props { heading?: string }
const { heading = 'Hiring a senior product designer? Let’s talk.' } = Astro.props;
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="wrap-case inner">
    <h2 id="cta-heading">{heading}</h2>
    <div class="actions">
      <a class="btn light" href={`mailto:${contact.email}`}>Email me</a>
      <a class="btn outline" href={url(contact.resumePdf)} target="_blank" rel="noopener">Resume (PDF)</a>
      <a class="btn outline" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--inverse); color: var(--on-inverse); padding-block: 48px; }
  .inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  h2 { font-size: var(--fs-h2); font-weight: 700; max-width: 520px; line-height: 1.2; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn.light { background: var(--on-inverse); color: #3b414e; font-weight: 500; }
  .btn.outline { background: transparent; border: 1px solid rgb(255 255 255 / 0.6); color: var(--on-inverse); font-weight: 400; }
</style>
