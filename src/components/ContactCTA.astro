---
// Matches the "Contact CTA" component in Figma (Components page): a panel band in light mode,
// the inverse band in dark mode, with the same Email Me / Resume / LinkedIn buttons as Home.
import { contact } from '../data/projects';
import { url } from '../lib/url';
interface Props { heading?: string }
const { heading = 'Hiring a product designer? Let’s talk.' } = Astro.props;
const [q, ...rest] = heading.split('? ');
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="wrap-case inner">
    <h2 id="cta-heading">{rest.length ? <>{q}? <span class="line">{rest.join('? ')}</span></> : heading}</h2>
    <div class="actions">
      <a class="pill-btn solid" href={`mailto:${contact.email}`}>
        <svg viewBox="0 -960 960 960" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M172.31-180Q142-180 121-201q-21-21-21-51.31v-455.38Q100-738 121-759q21-21 51.31-21h615.38Q818-780 839-759q21 21 21 51.31v455.38Q860-222 839-201q-21 21-51.31 21H172.31ZM480-457.69 160-662.31v410q0 5.39 3.46 8.85t8.85 3.46h615.38q5.39 0 8.85-3.46t3.46-8.85v-410L480-457.69Zm0-62.31 313.85-200h-627.7L480-520Z"/></svg>
        Email Me
      </a>
      <a class="pill-btn outline" href={url(contact.resumePdf)} download="Jeremy-Hamann-Resume.pdf">
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path d="M9 3V11.25M12.375 7.875L9 11.25L5.625 7.875M3.75 14.25H14.25" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Resume
      </a>
      <a class="pill-btn outline" href={contact.linkedin} target="_blank" rel="noopener">
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.9274 13.9303H11.8542V10.6818C11.8542 9.90708 11.8385 8.91017 10.7739 8.91017C9.693 8.91017 9.52792 9.75308 9.52792 10.6246V13.9303H7.45475V7.25H9.44625V8.16058H9.47308C9.75133 7.63558 10.428 7.08142 11.4389 7.08142C13.5395 7.08142 13.928 8.46392 13.928 10.2635L13.9274 13.9303ZM5.11325 6.33592C4.44592 6.33592 3.90983 5.79575 3.90983 5.13133C3.90983 4.4675 4.4465 3.92792 5.11325 3.92792C5.77825 3.92792 6.31725 4.4675 6.31725 5.13133C6.31725 5.79575 5.77767 6.33592 5.11325 6.33592ZM6.15275 13.9303H4.07375V7.25H6.15275V13.9303ZM14.9646 2H3.03308C2.462 2 2 2.4515 2 3.00858V14.9914C2 15.5491 2.462 16 3.03308 16H14.9628C15.5333 16 16 15.5491 16 14.9914V3.00858C16 2.4515 15.5333 2 14.9628 2H14.9646Z"/></svg>
        LinkedIn
      </a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--panel); color: var(--ink); padding-block: 48px; }
  :global(:root[data-theme='dark']) .cta { background: var(--inverse); }
  :global(:root[data-theme='dark']) .cta h2 { color: #ffffff; }
  .inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  h2 { font-size: 24px; font-weight: 700; line-height: 1.2; max-width: 520px; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill-btn { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 16px; border-radius: 8px; font-size: 14px; font-weight: 500; line-height: 19.6px; text-decoration: none; white-space: nowrap; }
  .pill-btn.solid { background: var(--ink); color: var(--on-ink); }
  .pill-btn.outline { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .pill-btn:hover { text-decoration: none; filter: brightness(0.94); }
  @media (max-width: 1100px) { h2 { max-width: 360px; } }
  @media (max-width: 799px) {
    .inner { flex-direction: column; align-items: flex-start; }
    h2 { font-size: 22px; max-width: none; }
    .line { display: block; }
    .pill-btn { font-size: 12px; }
  }
</style>
