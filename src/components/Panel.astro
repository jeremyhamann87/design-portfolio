---
// Full-width dark band holding one 800px colored image panel and a white caption (Schwab case studies).
import Figure from './Figure.astro';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; gap?: number }
const { src, alt, caption, gap = 12 } = Astro.props;
---
<div class="panel" style={`--pg:${gap}px`}>
  <Figure src={src} alt={alt} caption={caption} sizes="(max-width: 880px) 100vw, 800px" />
</div>
<style>
  .panel { background: var(--inverse); padding: 48px var(--band-pad); }
  .panel :global(.fig) { max-width: 800px; margin-inline: auto; gap: var(--pg); }
  .panel :global(img) { border-radius: 5px; }
  .panel :global(figcaption) { color: #fff; font-size: 16px; font-weight: 200; line-height: 1.2; }
  @media (max-width: 767px) { .panel { padding-block: 36px; } }
</style>
